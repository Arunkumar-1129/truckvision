{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web_dashboard/frontend && npm install && npm run build",
  "outputDirectory": "web_dashboard/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
